{
  "name": "figma-ai-wireframer-plugin",
  "version": "1.0.0",
  "description": "Figma plugin for AI-powered wireframe generation",
  "scripts": {
    "dev": "esbuild code.ts --bundle --outfile=code.js --target=es2020 --sourcemap --watch --loader:.html=text",
